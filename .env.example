# Rutiini -- environment configuration
#
# Copy to .env and fill in. Only DATABASE_URL and JWT_SECRET are required;
# everything else has a working default.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Works with any PostgreSQL 14+ server: a managed service, a container, or a
# server in a municipality's own data centre.
DATABASE_URL=postgres://user:password@localhost:5432/rutiini

# Signing key for session tokens. The server refuses to start in production
# without it. Generate one per environment and never reuse it:
#
#   openssl rand -base64 48
#
# Rotating this value signs everyone out, which is what you want if it leaks.
JWT_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Which driver to use: 'neon' (WebSocket, for Neon-hosted databases) or
# 'postgres' (ordinary TCP). Left unset, the host in DATABASE_URL decides:
# *.neon.tech uses the Neon driver, anything else uses plain PostgreSQL.
# DATABASE_DRIVER=

# Maximum pooled connections per instance. Multiply by the number of instances
# and keep the total below the server's max_connections.
# DATABASE_POOL_MAX=20

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# PORT=5000
# NODE_ENV=production

# Allowed browser origins, comma-separated. Leave unset only if the API and the
# web client are served from the same origin, which is the default deployment.
# The iOS and Android builds are always allowed: they call the API from the
# webview's own origin and are the product itself, not a third-party site.
# CORS_ORIGIN=https://rutiini.com,https://asiointi.helsinki.fi

# Development only: extra hostnames the Vite dev server may be reached through,
# comma-separated. Needed when developing behind a tunnel or proxy.
# DEV_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Mobile builds (iOS and Android)
# ---------------------------------------------------------------------------

# The address the mobile app talks to, baked in when the app bundle is built.
#
# The web client is served by this same process, so it uses relative paths and
# ignores this. A native build has no such server: Capacitor serves the bundle
# from its own localhost origin, so without this the app cannot reach the API at
# all -- not even to sign in. It has to be an address the phone can reach over
# the internet, not localhost, and it must be HTTPS.
#
#   VITE_API_URL=https://rutiini.example.fi npm run build
#   npx cap sync
#
# VITE_API_URL=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
#
# Required in production: without it a password reset request is accepted, the
# user is told a link has been sent, and nothing is ever delivered. The server
# refuses to start rather than leave people locked out.
#
# Plain SMTP, so the sender is yours to choose -- the municipality's own mail
# server, or a provider with a data processing agreement and EU hosting.

SMTP_HOST=
# SMTP_PORT=587
# 465 is implicit TLS; 587 and 25 upgrade with STARTTLS. Left unset this follows
# the port.
# SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# The From address recipients see. Use an address on a domain you control, or the
# messages will be treated as spam.
# SMTP_FROM=Rutiini <no-reply@rutiini.com>

# Public address of this deployment, used to build the link in the reset email.
# A link pointing at localhost is useless to whoever receives it.
APP_URL=https://rutiini.com

# ---------------------------------------------------------------------------
# Push notifications
# ---------------------------------------------------------------------------
#
# Optional. Without it the app still writes every notification and shows it
# in-app; what is lost is delivery to the phone when the app is closed.
#
# One Firebase project covers both Android and iOS. Create it, add an app with
# the id com.rutiini.app, then take a service account key from
# Project settings -> Service accounts -> Generate new private key.
#
# Paste the downloaded JSON as one line, or base64-encode it if your host cannot
# carry a multi-line value:  base64 -w0 service-account.json
FCM_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
#
# Authenticated requests are counted per signed-in user, so a daycare sharing one
# public IP address does not share one budget. Only anonymous traffic is counted
# per IP.

# General API traffic, per user per window.
# RATE_LIMIT_MAX=600
# RATE_LIMIT_WINDOW_MS=60000

# Failed sign-in attempts per IP. Successful sign-ins are not counted, and
# per-account lockout (5 attempts) is the primary brute-force defence.
# RATE_LIMIT_LOGIN_MAX=50
# RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Password reset requests per IP.
# RATE_LIMIT_RESET_MAX=20
# RATE_LIMIT_RESET_WINDOW_MS=3600000

# Anonymous endpoints behind the login screen's municipality and daycare pickers.
# RATE_LIMIT_PUBLIC_MAX=300
# RATE_LIMIT_PUBLIC_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# GDPR data retention
# ---------------------------------------------------------------------------
#
# Records older than these limits are deleted by a nightly job at 02:00
# Europe/Helsinki. Set them to match the retention period agreed with the
# municipality in the data processing agreement.

# RETENTION_AUDIT_MONTHS=12
# RETENTION_MESSAGES_MONTHS=12
# RETENTION_TRIPS_MONTHS=12
# RETENTION_ABSENCES_MONTHS=24
# RETENTION_NOTIFICATIONS_MONTHS=6
# RETENTION_ENTRIES_MONTHS=24
# Care time. Longer than the rest by default because these figures are what a
# later billing period is reconciled against, and a deleted stay cannot be
# recomputed. Set these to match the retention agreed in your data processing
# agreement.
# RETENTION_RESERVATIONS_MONTHS=36
# RETENTION_ATTENDANCE_MONTHS=36

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------
#
# Used by docker-compose.yml to provision the bundled PostgreSQL container. When
# connecting to a database you already run, ignore these and set DATABASE_URL.
# The compose file builds DATABASE_URL from them and overrides the value above.

# POSTGRES_USER=rutiini
# POSTGRES_DB=rutiini
# Required by docker-compose.yml; compose refuses to start without it.
POSTGRES_PASSWORD=

# Host port the application is published on.
# APP_PORT=5000

# --- Error reporting -------------------------------------------------------
# Optional. Unset, nothing is sent anywhere and the application behaves exactly
# as before. Set it and server faults (HTTP 5xx) are reported to Sentry, which
# emails you.
#
# What is sent: the error type, a scrubbed message, the stack trace, the route
# TEMPLATE (/api/children/:id/entries, never the real id), the HTTP method and
# status, the caller's role, and which daycare hit it.
#
# What is never sent: the request body, the query string, headers, cookies,
# earlier requests, and any identity beyond a role. The payload is assembled
# field by field in server/errorReporting.ts rather than collected by an SDK,
# so nothing can be added to it by accident.
#
# Sentry becomes a processor of the data above under your data processing
# agreement. It holds no child or guardian data, but it does receive daycare
# ids and IP-free error text; name it in the agreement.
# SENTRY_DSN=https://key@o0.ingest.sentry.io/0

# Sets the release shown on each report. On Railway, set this to
# ${{RAILWAY_GIT_COMMIT_SHA}} so an alert says which deploy broke.
# APP_VERSION=

# Exposes GET /api/debug/trigger-error, which throws on purpose so you can
# confirm once that alerts arrive and that scrubbing works. Requires a
# daycareleader or super admin token. LEAVE THIS UNSET IN PRODUCTION -- an
# endpoint that throws on demand is a way to hammer your error budget.
# ERROR_REPORTING_TEST_ROUTE=true
